#!/usr/bin/env python3
"""cxa - switch between Codex CLI logins.

Codex keeps exactly one signed-in account in ~/.codex/auth.json. cxa snapshots
that file per account and swaps it back in on demand, so changing accounts costs
no browser round trip and never needs `codex logout`.

It also reads the rate-limit windows Codex records in its own session logs, so
`cxa status` can show how much of each account is left and `cxa auto` can move
you to the one with the most headroom.

No dependencies, no network calls, and Codex's own configuration is never
touched - cxa is invisible to it.
"""

from __future__ import annotations

import base64
import calendar
import glob
import json
import os
import re
import select
import shutil
import subprocess
import sys
import termios
import time
import tty
import urllib.error
import urllib.request
from dataclasses import dataclass
from typing import Any, Iterable, NamedTuple

# --------------------------------------------------------------------- settings

CODEX_HOME = os.path.expanduser(os.environ.get("CODEX_HOME", "~/.codex"))
AUTH = os.path.join(CODEX_HOME, "auth.json")
SESSIONS = os.path.join(CODEX_HOME, "sessions")

STORE = os.path.join(CODEX_HOME, "accounts")
JOURNAL = os.path.join(STORE, ".journal.jsonl")
STATE = os.path.join(STORE, ".state.json")

#: A window at or above this percent counts as spent. Lower it to rotate sooner.
FULL = float(os.environ.get("CXA_FULL", 100))

#: Windows no longer than this are the short, fast-refilling kind (Codex uses 5h).
SHORT_WINDOW_MINUTES = 1440

#: ChatGPT's own usage endpoints. Undocumented, so every read is best-effort.
USAGE_URL = "https://chatgpt.com/backend-api/wham/usage"
CREDITS_URL = "https://chatgpt.com/backend-api/wham/rate-limit-reset-credits"
NETWORK_TIMEOUT = 20

#: Session logs run to tens of megabytes, so only their tail is ever read.
TAIL_BYTES = 400_000
MAX_LOGS_PER_SCAN = 120

DIM, GREEN, YELLOW, RED, BOLD, OFF = (
    "\033[2m", "\033[32m", "\033[33m", "\033[31m", "\033[1m", "\033[0m",
)
if not sys.stdout.isatty():
    DIM = GREEN = YELLOW = RED = BOLD = OFF = ""

ANSI = re.compile(r"\033\[[0-9;]*[A-Za-z]")


def die(message: str) -> "NoReturn":  # noqa: F821 - quoted for 3.8 compatibility
    sys.exit(f"cxa: {message}")


def read_json(path: str, default: Any = None) -> Any:
    try:
        with open(path) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return {} if default is None else default


def write_json(path: str, payload: Any) -> None:
    os.makedirs(STORE, mode=0o700, exist_ok=True)
    with open(path, "w") as fh:
        json.dump(payload, fh)
    os.chmod(path, 0o600)


# ---------------------------------------------------------------------- accounts


@dataclass(frozen=True)
class Account:
    name: str
    path: str
    email: str
    plan: str
    account_id: str


def read_identity(path: str) -> "tuple[str, str, str]":
    """(email, plan, account_id) for an auth.json, read straight from its id_token."""
    data = read_json(path)
    if not data:
        return ("(unreadable)", "-", "")
    tokens = data.get("tokens") or {}
    email = plan = ""
    parts = (tokens.get("id_token") or "").split(".")
    if len(parts) > 1:
        payload = parts[1] + "=" * (-len(parts[1]) % 4)
        try:
            claims = json.loads(base64.urlsafe_b64decode(payload))
            email = claims.get("email") or ""
            plan = (claims.get("https://api.openai.com/auth") or {}).get("chatgpt_plan_type") or ""
        except (ValueError, TypeError):
            pass
    if not email and data.get("OPENAI_API_KEY"):
        email, plan = "api key", "apikey"
    return (email or "?", plan or data.get("auth_mode") or "-", tokens.get("account_id") or "")


def list_accounts() -> "list[Account]":
    os.makedirs(STORE, mode=0o700, exist_ok=True)
    found = []
    for entry in sorted(os.listdir(STORE)):
        if not entry.endswith(".json") or entry.startswith("."):
            continue
        if entry.endswith((".usage.json", ".meta.json")):
            continue
        path = os.path.join(STORE, entry)
        found.append(Account(entry[: -len(".json")], path, *read_identity(path)))
    return found


def find_account(name: str) -> Account:
    for account in list_accounts():
        if account.name == name:
            return account
    die(f"unknown account '{name}'")


def active_id() -> str:
    return read_identity(AUTH)[2] if os.path.exists(AUTH) else ""


def sync_active() -> None:
    """Codex refreshes tokens in place, so freshen the stored copy before any swap."""
    current = active_id()
    if not current:
        return
    for account in list_accounts():
        if account.account_id == current:
            try:
                if open(account.path, "rb").read() != open(AUTH, "rb").read():
                    shutil.copyfile(AUTH, account.path)
            except OSError:
                pass
            return


def running_codex() -> "tuple[list[int], bool]":
    """(cli pids, desktop app running). The ChatGPT app ships a dozen helper
    processes with `codex` in their path, so only its bundle is counted, once."""
    try:
        listing = subprocess.run(["ps", "-Ao", "pid=,comm="], capture_output=True,
                                 text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return ([], False)
    cli, app = [], False
    for line in listing.splitlines():
        pid, _, command = line.strip().partition(" ")
        if ".app/" in command.lower() or "/Contents/" in command:
            app = app or bool(re.search(r"/(ChatGPT|Codex)\.app/", command))
            continue
        if os.path.basename(command) == "codex" and pid.isdigit():
            cli.append(int(pid))
    return (cli, app)


def warn_if_codex_running() -> bool:
    """A live session keeps using the token it already loaded, so a swap under it
    is at best ignored and at worst written back over. Returns False to abort."""
    cli, app = running_codex()
    if not cli and not app:
        return True
    if app and not cli:
        print(f"{YELLOW}note{OFF} the Codex desktop app is running; it keeps the old "
              f"login until you restart it")
        return True
    plural = "s" if len(cli) > 1 else ""
    print(f"{YELLOW}warning{OFF} {len(cli)} codex CLI session{plural} running "
          f"(pid {', '.join(str(p) for p in cli)})")
    if os.environ.get("CXA_YES") or not sys.stdin.isatty():
        return True
    try:
        return input("switch anyway? [y/N] ").strip().lower().startswith("y")
    except (EOFError, KeyboardInterrupt):
        print()
        return False


def save_active(name: "str | None" = None) -> None:
    if not os.path.exists(AUTH):
        die("not logged in - run `cxa login` first")
    email = read_identity(AUTH)[0]
    if not name:
        stem = email.split("@")[0].lower()
        name = "".join(c if c.isalnum() or c in "._-" else "-" for c in stem).strip("-.")
    if not name:
        die("could not derive a name from the login, pass one: cxa save <name>")
    os.makedirs(STORE, mode=0o700, exist_ok=True)
    destination = os.path.join(STORE, name + ".json")
    shutil.copyfile(AUTH, destination)
    os.chmod(destination, 0o600)
    record_switch(name)
    print(f"{GREEN}saved{OFF} {name}  {DIM}{email}{OFF}")


def activate(name: str) -> None:
    account = find_account(name)
    if not warn_if_codex_running():
        print("cancelled")
        return
    sync_active()
    shutil.copyfile(account.path, AUTH)
    os.chmod(AUTH, 0o600)
    record_switch(name)
    print(f"{GREEN}->{OFF} {name}  {DIM}{account.email}{OFF}")


def login(name: "str | None" = None) -> None:
    if not shutil.which("codex"):
        die("codex CLI not found in PATH")
    sync_active()
    if os.path.exists(AUTH):
        os.remove(AUTH)
    subprocess.run(["codex", "login"])
    if os.path.exists(AUTH):
        save_active(name)
    else:
        print("cxa: login did not complete, nothing saved")


def forget(name: str) -> None:
    find_account(name)
    for suffix in (".json", ".usage.json", ".meta.json"):
        try:
            os.remove(os.path.join(STORE, name + suffix))
        except OSError:
            pass
    print(f"removed {name}")


# ------------------------------------------------------------------ rate limits
#
# Codex writes its rate-limit windows into its own session logs but never records
# which account they belong to. cxa therefore journals every switch it makes and
# attributes each observation to whichever account was active at that moment.


def journal_entries() -> "list[dict]":
    try:
        with open(JOURNAL) as fh:
            return [json.loads(line) for line in fh if line.strip()]
    except (OSError, ValueError):
        return []


def record_switch(name: str) -> None:
    entries = journal_entries()
    if not entries:
        # First run: everything logged so far belongs to whatever is active now.
        write_json(JOURNAL + ".tmp", {})
        os.remove(JOURNAL + ".tmp")
        with open(JOURNAL, "w") as fh:
            fh.write(json.dumps({"t": 0, "name": name}) + "\n")
        os.chmod(JOURNAL, 0o600)
        return
    if entries[-1]["name"] != name:
        with open(JOURNAL, "a") as fh:
            fh.write(json.dumps({"t": int(time.time()), "name": name}) + "\n")


def account_at(when: int, entries: "list[dict]") -> "str | None":
    name = None
    for entry in entries:
        if entry["t"] > when:
            break
        name = entry["name"]
    return name


def latest_limits_in(path: str) -> "tuple[int, dict] | None":
    """Newest (timestamp, rate_limits) in one session log, reading only its tail."""
    try:
        with open(path, "rb") as fh:
            fh.seek(max(0, os.path.getsize(path) - TAIL_BYTES))
            tail = fh.read()
    except OSError:
        return None
    for line in reversed(tail.split(b"\n")):
        if b'"used_percent"' not in line:
            continue
        try:
            record = json.loads(line)
        except ValueError:
            continue
        limits = (record.get("payload") or {}).get("rate_limits") or {}
        if not (limits.get("primary") or limits.get("secondary")):
            continue
        try:
            stamp = calendar.timegm(time.strptime(record["timestamp"][:19], "%Y-%m-%dT%H:%M:%S"))
        except (KeyError, ValueError):
            stamp = int(os.path.getmtime(path))
        return (stamp, limits)
    return None


def refresh_usage() -> None:
    """Fold newly written session logs into one usage snapshot per account."""
    entries = journal_entries()
    if not entries:
        current = active_id()
        for account in list_accounts():
            if account.account_id and account.account_id == current:
                record_switch(account.name)
                entries = journal_entries()
                break

    since = read_json(STATE).get("last_scan", 0)
    logs = [
        path
        for path in glob.glob(os.path.join(SESSIONS, "*", "*", "*", "rollout-*.jsonl"))
        if os.path.getmtime(path) >= since - 60
    ]
    logs.sort(key=os.path.getmtime)

    newest: "dict[str, tuple[int, dict]]" = {}
    for path in logs[-MAX_LOGS_PER_SCAN:]:
        found = latest_limits_in(path)
        if not found:
            continue
        stamp, limits = found
        name = account_at(stamp, entries)
        if name and stamp >= newest.get(name, (0, {}))[0]:
            newest[name] = (stamp, limits)

    for name, (stamp, limits) in newest.items():
        path = os.path.join(STORE, name + ".usage.json")
        if read_json(path).get("observed_at", 0) > stamp:
            continue  # a manual reset is more current than the log
        write_json(path, {"observed_at": stamp, **limits})
    write_json(STATE, {"last_scan": int(time.time())})


class Window(NamedTuple):
    percent: "float | None" = None
    resets_at: "int | None" = None
    minutes: "int | None" = None

    @property
    def known(self) -> bool:
        return self.percent is not None

    @property
    def left(self) -> float:
        """Headroom, the way Codex itself reports it - the logs count upwards."""
        return 100.0 - (self.percent or 0.0)


class Limits(NamedTuple):
    short: Window
    long: Window
    observed_at: "int | None"

    @property
    def windows(self) -> "tuple[Window, Window]":
        return (self.short, self.long)

    @property
    def next_reset(self) -> "int | None":
        upcoming = [w.resets_at for w in self.windows if w.resets_at]
        return min(upcoming) if upcoming else None


def limits_for(name: str) -> Limits:
    """Windows sorted by length, not by Codex's primary/secondary keys - which of
    those two holds the 5h window differs from account to account. A window past
    its reset time counts as empty again."""
    snapshot = read_json(os.path.join(STORE, name + ".usage.json"))
    slots = {"short": Window(), "long": Window()}
    for key in ("primary", "secondary"):
        raw = snapshot.get(key)
        if not raw or raw.get("used_percent") is None:
            continue
        minutes = raw.get("window_minutes") or 0
        slot = "short" if minutes <= SHORT_WINDOW_MINUTES else "long"
        resets_at = raw.get("resets_at") or 0
        if resets_at and resets_at <= time.time():
            slots[slot] = Window(0.0, None, minutes)
        else:
            slots[slot] = Window(raw["used_percent"], resets_at or None, minutes)
    return Limits(slots["short"], slots["long"], snapshot.get("observed_at"))


# ------------------------------------------------------------------ live sync
#
# Everything above works offline from Codex's own logs. These two calls are the
# only ones that touch the network: they ask ChatGPT for an account's current
# windows, which is the only way to see an account you have not used lately -
# and the only place reset credits are published at all.


def api_get(url: str, account: Account) -> Any:
    """GET one of ChatGPT's usage endpoints as that account. Raises on failure."""
    token = (read_json(account.path).get("tokens") or {}).get("access_token")
    if not token:
        raise RuntimeError("no access token stored")
    request = urllib.request.Request(url, headers={
        "Authorization": f"Bearer {token}",
        "Accept": "application/json",
        "OpenAI-Beta": "codex-1",
        "originator": "codex_cli_rs",
        "ChatGPT-Account-ID": account.account_id,
    })
    try:
        with urllib.request.urlopen(request, timeout=NETWORK_TIMEOUT) as response:
            return json.loads(response.read())
    except urllib.error.HTTPError as error:
        if error.code in (401, 403):
            raise RuntimeError("token expired - switch to this account once to refresh it")
        raise RuntimeError(f"HTTP {error.code}")
    except (urllib.error.URLError, ValueError, TimeoutError) as error:
        raise RuntimeError(str(getattr(error, "reason", error))[:60])


def as_snapshot(window: Any) -> "dict | None":
    """One API window in the same shape Codex writes into its session logs."""
    if not isinstance(window, dict) or window.get("used_percent") is None:
        return None
    seconds = window.get("limit_window_seconds") or 0
    return {
        "used_percent": float(window["used_percent"]),
        "window_minutes": int(seconds // 60) or None,
        "resets_at": window.get("reset_at") or None,
    }


def local_date(stamp: Any) -> "str | None":
    """ChatGPT dates arrive as UTC; show the day the user actually sees."""
    if isinstance(stamp, (int, float)):
        return time.strftime("%Y-%m-%d", time.localtime(stamp))
    try:
        text = str(stamp).replace("Z", "+0000").replace("+00:00", "+0000")
        parsed = time.strptime(text[:19], "%Y-%m-%dT%H:%M:%S")
        return time.strftime("%Y-%m-%d", time.localtime(calendar.timegm(parsed)))
    except (ValueError, TypeError):
        return str(stamp)[:10] or None


def sync_account(account: Account) -> str:
    """Refresh one account from the API. Returns a short status line."""
    try:
        usage = api_get(USAGE_URL, account)
    except RuntimeError as error:
        return f"{RED}x{OFF} {account.name}: {error}"

    limits = usage.get("rate_limit") or {}
    snapshot: "dict[str, Any]" = {"observed_at": int(time.time()), "source": "api"}
    for key, field in (("primary", "primary_window"), ("secondary", "secondary_window")):
        window = as_snapshot(limits.get(field) or limits.get(key))
        if window:
            snapshot[key] = window
    write_json(os.path.join(STORE, account.name + ".usage.json"), snapshot)

    # Reset credits live behind their own endpoint; the usage payload only counts them.
    try:
        credits = api_get(CREDITS_URL, account)
    except RuntimeError:
        credits = usage.get("rate_limit_reset_credits") or {}
    available = int(credits.get("available_count") or 0)
    fields: "dict[str, Any]" = {"resets_left": available}
    expiries = sorted(
        c["expires_at"] for c in (credits.get("credits") or [])
        if isinstance(c, dict) and c.get("expires_at") and c.get("status") != "used"
    )
    if expiries:
        fields["resets_expire"] = local_date(expiries[0])
    elif not available:
        fields["resets_expire"] = None
    write_meta(account.name, **fields)

    return f"{GREEN}+{OFF} {account.name}: {usage_summary(account.name)}"


# -------------------------------------------------------------------- rotation

READY, UNUSED, RESERVE, SPENT = range(4)
TIER_LABELS = {READY: "", UNUSED: "unused", RESERVE: "reserve", SPENT: "spent"}


def tier(name: str) -> int:
    """Short windows refill every few hours, so spend those accounts first and
    keep a weekly-only account in reserve for when they run dry."""
    limits = limits_for(name)
    if any(w.known and w.percent >= FULL for w in limits.windows):
        return SPENT
    if limits.short.known:
        return READY
    return RESERVE if limits.long.known else UNUSED


def rank_key(name: str) -> tuple:
    """Order accounts best-first: tier, then the 5h window, then the weekly one."""
    limits = limits_for(name)
    return (tier(name), limits.short.percent or 0.0, limits.long.percent or 0.0, name)


def best_first(accounts: "Iterable[Account]") -> "list[Account]":
    return sorted(accounts, key=lambda a: rank_key(a.name))


# --------------------------------------------------------- manual reset credits
#
# ChatGPT grants occasional "usage limit resets" that Codex never reports, so the
# count and its expiry are whatever the user tells cxa.


def read_meta(name: str) -> dict:
    return read_json(os.path.join(STORE, name + ".meta.json"))


def write_meta(name: str, **fields: Any) -> dict:
    meta = read_meta(name)
    meta.update(fields)
    write_json(os.path.join(STORE, name + ".meta.json"), meta)
    return meta


def mark_reset(name: str) -> None:
    """Record that the account was reset elsewhere: zero its cached windows,
    keeping their shape, and count one reset off."""
    snapshot = read_json(os.path.join(STORE, name + ".usage.json"))
    fresh: "dict[str, Any]" = {"observed_at": int(time.time()), "reset_marked": True}
    for key in ("primary", "secondary"):
        window = snapshot.get(key)
        if window:
            fresh[key] = {
                "used_percent": 0.0,
                "window_minutes": window.get("window_minutes"),
                "resets_at": None,
            }
    write_json(os.path.join(STORE, name + ".usage.json"), fresh)

    left = read_meta(name).get("resets_left")
    if isinstance(left, int) and left > 0:
        left -= 1
        write_meta(name, resets_left=left)
    tail = f", {left} reset(s) left" if isinstance(left, int) else ""
    print(f"{GREEN}reset{OFF} {name}  {DIM}usage cleared{tail}{OFF}")


# --------------------------------------------------------------------- rendering


def format_countdown(resets_at: "int | None") -> str:
    if not resets_at:
        return ""
    left = int(resets_at - time.time())
    if left < 60:
        return "now"
    days, rest = divmod(left, 86400)
    hours, minutes = divmod(rest // 60, 60)
    if days:
        return f"{days}d {hours}h"
    return f"{hours}h {minutes}m" if hours else f"{minutes}m"


def window_label(minutes: "int | None") -> str:
    if not minutes:
        return ""
    if minutes >= 10080:
        return "wk"
    if minutes >= 1440:
        return f"{minutes // 1440}d"
    return f"{minutes // 60}h" if minutes >= 60 else f"{minutes}m"


def headroom_color(left: float) -> str:
    return RED if left < 10 else (YELLOW if left < 35 else GREEN)


def format_reset(resets_at: "int | None") -> str:
    """A countdown while it is close, a calendar day once it is not."""
    if not resets_at:
        return ""
    if resets_at - time.time() < 86400:
        return format_countdown(resets_at)
    return time.strftime("%b %-d", time.localtime(resets_at))


def usage_summary(name: str) -> str:
    """One-line headroom for messages, e.g. `5h 88% left · wk 59% left`."""
    parts = [
        f"{DIM}{window_label(w.minutes)}{OFF} "
        f"{headroom_color(w.left)}{w.left:.0f}%{OFF} {DIM}left{OFF}"
        for w in limits_for(name).windows
        if w.known
    ]
    return f" {DIM}\u00b7{OFF} ".join(parts) if parts else f"{DIM}no data yet{OFF}"


def pad(text: str, width: int, right: bool = False) -> str:
    """Pad to a visible width, ignoring the colour codes inside `text`."""
    space = " " * max(0, width - len(ANSI.sub("", text)))
    return space + text if right else text + space


#: `left` and `resets` for one window, then the same for the other.
GROUP = 4 + 2 + 7
CREDITS = 10


def usage_cells(name: str) -> "tuple[str, str]":
    """Each window as `left  resets`, in the same shape as the Codex usage panel."""
    cells = []
    for window in limits_for(name).windows:
        left = (f"{headroom_color(window.left)}{window.left:.0f}%{OFF}"
                if window.known else f"{DIM}-{OFF}")
        cells.append(f"{pad(left, 4, right=True)}  "
                     f"{pad(DIM + format_reset(window.resets_at) + OFF, 7)}")
    return cells[0], cells[1]


#: The two header lines over the usage columns; callers supply the left-hand
#: labels, which is why these carry no indent of their own.
USAGE_HEADINGS = (
    f"{pad('5h', GROUP)}  {pad('weekly', GROUP)}  {pad('', CREDITS)}",
    f"{pad('left', 4, right=True)}  {pad('resets', 7)}  "
    f"{pad('left', 4, right=True)}  {pad('resets', 7)}  {pad('credits', CREDITS)}",
)


def reset_credits(name: str) -> str:
    """Full resets ChatGPT has granted this account, with the first expiry."""
    meta = read_meta(name)
    left = meta.get("resets_left")
    if not isinstance(left, int):
        return pad(f"{DIM}?{OFF}", CREDITS)
    if left < 1:
        return pad(f"{DIM}-{OFF}", CREDITS)
    expiry = meta.get("resets_expire")
    day = f" {DIM}{format_day(expiry)}{OFF}" if expiry else ""
    return pad(f"{YELLOW}{left}{OFF}{day}", CREDITS)


def format_day(iso: str) -> str:
    """`2026-09-21` as `Sep 21`, to read like the window resets beside it."""
    try:
        return time.strftime("%b %-d", time.strptime(iso, "%Y-%m-%d"))
    except (ValueError, TypeError):
        return str(iso)


def last_seen(observed_at: "int | None") -> str:
    if not observed_at:
        return "-"
    ago = format_countdown(2 * time.time() - observed_at)
    return "just now" if ago in ("", "now") else f"{ago} ago"


# ------------------------------------------------------------------ terminal ui


class raw_terminal:
    """Hold raw mode for a whole picker session - re-entering it per keypress
    lets the tty echo characters that then vanish from the query."""

    def __enter__(self) -> "raw_terminal":
        self.fd = sys.stdin.fileno()
        self.saved = termios.tcgetattr(self.fd)
        tty.setraw(self.fd)
        return self

    def __exit__(self, *_: Any) -> None:
        termios.tcsetattr(self.fd, termios.TCSADRAIN, self.saved)


def read_key() -> str:
    fd = sys.stdin.fileno()
    char = os.read(fd, 1).decode(errors="ignore")
    if char != "\033":
        return char
    # A bare Esc sends no follow-up bytes, so never block waiting for them.
    sequence = ""
    while len(sequence) < 2 and select.select([fd], [], [], 0.05)[0]:
        sequence += os.read(fd, 1).decode(errors="ignore")
    return {"[A": "up", "[B": "down"}.get(sequence, "esc")


def fuzzy_match(query: str, label: str) -> bool:
    """Subsequence match against the visible text only - labels carry colour codes."""
    haystack = iter(ANSI.sub("", label).lower())
    return all(char in haystack for char in query.lower())


def choose(rows: "list[tuple[str, Any]]", header: str, footer: str, on_tab=None) -> Any:
    """Type-to-filter picker. Returns the chosen row's value, or None if cancelled.

    `on_tab(value)` runs against the highlighted row when Tab is pressed and
    returns a fresh row list, letting the menu refresh a line without leaving."""
    query, cursor, drawn = "", 0, 0
    status = ""
    with raw_terminal():
        while True:
            matching = [row for row in rows if fuzzy_match(query, row[0])]
            if query:  # headings and blank lines only make sense in the full list
                matching = [row for row in matching if row[1] is not None]
            pickable = [i for i, row in enumerate(matching) if row[1] is not None]
            if pickable:
                cursor = min(pickable, key=lambda i: (abs(i - cursor), i))

            room = max(3, shutil.get_terminal_size((80, 24)).lines - 3)
            top = 0
            if len(matching) > room:
                top = max(0, min(cursor - room // 2, len(matching) - room))
            visible = matching[top : top + room]

            frame = [f"\033[{drawn}A"] if drawn else []
            frame.append(f"{header} {query}\033[K\r\n")
            for offset, (label, _value) in enumerate(visible):
                marker = f"{GREEN}{BOLD}>{OFF}" if top + offset == cursor else " "
                frame.append(f"{marker} {label}\033[K\r\n")
            frame.append(f"{DIM}{status or footer}{OFF}\033[K\r\n\033[J")
            sys.stdout.write("".join(frame))
            sys.stdout.flush()
            drawn = len(visible) + 2

            key = read_key()
            if key == "\t" and on_tab and pickable:
                status = "refreshing..."
                sys.stdout.write(f"\033[1A{DIM}{status}{OFF}\033[K\r\n\033[J")
                sys.stdout.flush()
                rows, status = on_tab(matching[cursor][1])
                continue
            status = ""
            if key in ("\x03", "esc"):
                sys.stdout.write("\r\n")
                return None
            if key in ("\r", "\n"):
                sys.stdout.write("\r\n")
                return matching[cursor][1] if pickable else None
            if key == "up":
                cursor = next((i for i in reversed(pickable) if i < cursor), cursor)
            elif key == "down":
                cursor = next((i for i in pickable if i > cursor), cursor)
            elif key in ("\x7f", "\b"):
                query = query[:-1]
            elif key.isprintable():
                query, cursor = query + key, 0


def choose_account(header: str, annotate=None) -> "str | None":
    rows = []
    for account in list_accounts():
        suffix = f"  {DIM}{annotate(account)}{OFF}" if annotate else ""
        rows.append((f"  {account.name:<14}{DIM}{account.email}{OFF}{suffix}", account.name))
    return choose(rows, f"{BOLD}{header}{OFF}", "esc to cancel")


# ------------------------------------------------------------------- commands


def cmd_status(*_: str) -> None:
    """usage and reset time per account"""
    refresh_usage()
    accounts = list_accounts()
    if not accounts:
        print("no saved accounts yet - run `cxa login`")
        return
    current, favourite = active_id(), best_first(accounts)[0].name
    names = max([len(a.name) for a in accounts] + [7])
    mails = max([len(a.email) for a in accounts] + [5])
    plans = max([len(a.plan) for a in accounts] + [4])

    labels = f"  {pad('account', names)}  {pad('email', mails)}  {pad('plan', plans)}  "
    print(f"{DIM}{' ' * len(labels)}{USAGE_HEADINGS[0]}{OFF}")
    print(f"{DIM}{labels}{USAGE_HEADINGS[1]}  {pad('role', 8)}seen{OFF}")
    for account in accounts:
        short, long = usage_cells(account.name)
        if account.account_id and account.account_id == current:
            mark = f"{GREEN}*{OFF}"
        elif account.name == favourite:
            mark = f"{YELLOW}~{OFF}"
        else:
            mark = " "
        seen = last_seen(limits_for(account.name).observed_at)
        print(f"{mark} {pad(account.name, names)}  {DIM}{pad(account.email, mails)}  "
              f"{pad(account.plan, plans)}{OFF}  {short}  {long}  "
              f"{reset_credits(account.name)}  "
              f"{pad(TIER_LABELS[tier(account.name)], 8)}{DIM}{seen}{OFF}".rstrip())
    print(f"{DIM}  * active   ~ next up   |   percentages are what is LEFT, not what "
          f"you used\n"
          f"  a 5h window is spent before a weekly-only account, which is held in reserve\n"
          f"  `cxa sync` refreshes these from ChatGPT; tab does one line in the menu{OFF}")


def cmd_auto(*_: str) -> None:
    """switch to the account with the most headroom"""
    refresh_usage()
    accounts = list_accounts()
    if not accounts:
        die("no saved accounts")
    choice = best_first(accounts)[0]
    if choice.account_id == active_id():
        print(f"{GREEN}={OFF} {choice.name} already has the most headroom  "
              f"{usage_summary(choice.name)}")
        return
    activate(choice.name)
    print(f"  {usage_summary(choice.name)}")


def cmd_menu() -> None:
    """Interactive entry point: everything cxa can do, without memorising a verb."""
    if not sys.stdin.isatty():
        cmd_status()
        return

    sync_active()
    refresh_usage()

    def build() -> "list[tuple[str, Any]]":
        """One table of accounts, then the actions - both on the same left edge."""
        current, accounts = active_id(), list_accounts()
        names = max([len(a.name) for a in accounts] + [7])
        mails = max([len(a.email) for a in accounts] + [5])
        plans = max([len(a.plan) for a in accounts] + [4])

        def account_row(account: Account) -> str:
            short, long = usage_cells(account.name)
            live = account.account_id == current
            mark, name = (f"{GREEN}*{OFF}", BOLD) if live else (" ", "")
            return (f"{mark} {name}{pad(account.name, names)}{OFF if name else ''}  "
                    f"{DIM}{pad(account.email, mails)}  {pad(account.plan, plans)}{OFF}  "
                    f"{short}  {long}  {reset_credits(account.name)}".rstrip())

        indent = "  " + " " * (names + mails + plans + 6)
        rows: "list[tuple[str, Any]]" = (
            [(f"{DIM}{indent}{line}{OFF}", None) for line in USAGE_HEADINGS]
            if accounts else []
        )
        rows += [(account_row(a), ("use", a.name)) for a in accounts]

        actions = []
        if len(accounts) > 1:
            actions.append(("~", "rotate to the account with the most headroom", "auto"))
        if accounts:
            actions.append(("s", "refresh every account from ChatGPT", "sync"))
            actions.append(("o", "mark an account as reset", "reset"))
        if current and not any(a.account_id == current for a in accounts):
            actions.append(("+", f"save this login  {DIM}{read_identity(AUTH)[0]}{OFF}", "save"))
        actions.append(("+", "log in to a new account", "login"))
        if accounts:
            actions.append(("x", "delete an account", "forget"))

        rows.append(("", None))
        rows += [(f"{YELLOW}{key}{OFF} {text}", (kind, None)) for key, text, kind in actions]
        return rows

    def on_tab(value) -> "tuple[list, str]":
        """Tab on an account line refreshes just that one, in place."""
        kind, name = value
        if kind == "sync":
            for account in list_accounts():
                sync_account(account)
            return (build(), "refreshed every account")
        if kind != "use":
            return (build(), "tab refreshes an account line")
        note = ANSI.sub("", sync_account(find_account(name)))
        return (build(), note if note.startswith("x") else f"refreshed {name}")

    action = choose(build(), f"{BOLD}codex accounts{OFF}",
                    "type to search  \u00b7  tab refreshes a line  \u00b7  "
                    "enter switches  \u00b7  esc quits", on_tab)
    if not action:
        return
    kind, argument = action

    if kind == "use":
        activate(argument)
    elif kind == "auto":
        cmd_auto()
    elif kind == "sync":
        cmd_sync()
    elif kind == "save":
        save_active()
    elif kind == "login":
        login()
    elif kind == "reset":
        def credits(account: Account) -> str:
            left = read_meta(account.name).get("resets_left")
            return f"{left} left" if isinstance(left, int) else ""
        name = choose_account("which account did you reset?", credits)
        if name:
            mark_reset(name)
    elif kind == "forget":
        name = choose_account("delete which?")
        if name:
            forget(name)


def cmd_save(name: str = "", *_: str) -> None:
    """save the current login under a name"""
    save_active(name or None)


def cmd_login(name: str = "", *_: str) -> None:
    """log in to another account and save it"""
    login(name or None)


def cmd_forget(name: str = "", *_: str) -> None:
    """delete a saved account"""
    forget(name) if name else die("usage: cxa rm <name>")


def cmd_reset(name: str = "", *_: str) -> None:
    """you used that account's reset - clear its cached usage"""
    mark_reset(name) if name else die("usage: cxa reset <name>")


def cmd_resets(name: str = "", count: str = "", expiry: str = "", *_: str) -> None:
    """record how many resets an account has left, and when they expire"""
    if not name or not count:
        die("usage: cxa resets <name> <count> [YYYY-MM-DD]")
    find_account(name)
    try:
        fields = {"resets_left": int(count)}
    except ValueError:
        die(f"'{count}' is not a number")
    if expiry:
        fields["resets_expire"] = expiry
    write_meta(name, **fields)
    print(f"{name}: {count} reset(s) left" + (f", expires {expiry}" if expiry else ""))


def cmd_sync(name: str = "", *_: str) -> None:
    """refresh usage from ChatGPT (one account, or all of them)"""
    targets = [find_account(name)] if name else list_accounts()
    if not targets:
        die("no saved accounts")
    for account in targets:
        print(sync_account(account))


def cmd_list(*_: str) -> None:
    """plain list, one account per line"""
    current = active_id()
    for account in list_accounts():
        marker = "*" if account.account_id == current else " "
        print(f"{marker} {account.name:<14}{account.email:<34}{account.plan}")


# ------------------------------------------------------------------------- cli

COMMANDS = {
    "save": cmd_save,
    "login": cmd_login,
    "rm": cmd_forget,
    "delete": cmd_forget,
    "reset": cmd_reset,
    "resets": cmd_resets,
    "sync": cmd_sync,
    "refresh": cmd_sync,
    "status": cmd_status,
    "st": cmd_status,
    "auto": cmd_auto,
    "next": cmd_auto,
    "list": cmd_list,
    "ls": cmd_list,
}

USAGE = """cxa - switch between Codex CLI logins

  cxa                                     menu: search, pick, switch, log in
  cxa <name>                              switch straight to a saved account
  cxa save [name]                         save the current login
  cxa login [name]                        log in to another account and save it
  cxa status                              usage and reset time per account
  cxa sync [name]                         refresh usage from ChatGPT (all, or one)
  cxa auto                                switch to the account with most headroom
  cxa reset <name>                        you used that account's reset elsewhere
  cxa resets <name> <count> [YYYY-MM-DD]  record reset credits and their expiry
  cxa rm <name>                           delete a saved account

Environment:
  CXA_FULL     percent at which a window counts as spent (default 100)
  CXA_YES      skip the "codex is running" confirmation
  CODEX_HOME   Codex config directory (default ~/.codex)

Profiles live in ~/.codex/accounts and hold live OAuth tokens.
Keep that directory out of git, Dropbox, and iCloud."""


def main(argv: "list[str]") -> None:
    if not argv:
        return cmd_menu()
    command, *rest = argv
    if command in ("-h", "--help", "help"):
        return print(USAGE)
    if command in COMMANDS:
        return COMMANDS[command](*rest)
    activate(command)


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except KeyboardInterrupt:
        sys.exit(130)
